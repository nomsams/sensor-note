<?xml version=\"1.0\" encoding=\"utf-8\"?>
<ScrollView xmlns:android=\"http://schemas.android.com/apk/res/android\"
    xmlns:app=\"http://schemas.android.com/apk/res-auto\"
    android:layout_width=\"match_parent\"
    android:layout_height=\"match_parent\"
    android:fillViewport=\"true\">

    <LinearLayout
        android:layout_width=\"match_parent\"
        android:layout_height=\"wrap_content\"
        android:orientation=\"vertical\"
        android:padding=\"16dp\">

        <androidx.appcompat.widget.Toolbar
            android:id=\"@+id/toolbar\"
            android:layout_width=\"match_parent\"
            android:layout_height=\"?attr/actionBarSize\"
            app:title=\"@string/audio_filter_tuner_title\" />

        <Switch
            android:id=\"@+id/filter_high_pass\"
            android:layout_width=\"match_parent\"
            android:layout_height=\"wrap_content\"
            android:text=\"High pass\" />

        <EditText
            android:id=\"@+id/filter_high_pass_hz\"
            android:layout_width=\"match_parent\"
            android:layout_height=\"wrap_content\"
            android:hint=\"HP Hz\"
            android:inputType=\"numberDecimal\" />

        <Switch
            android:id=\"@+id/filter_low_pass\"
            android:layout_width=\"match_parent\"
            android:layout_height=\"wrap_content\"
            android:text=\"Low pass\" />

        <EditText
            android:id=\"@+id/filter_low_pass_hz\"
            android:layout_width=\"match_parent\"
            android:layout_height=\"wrap_content\"
            android:hint=\"LP Hz\"
            android:inputType=\"numberDecimal\" />

        <Switch
            android:id=\"@+id/filter_notch\"
            android:layout_width=\"match_parent\"
            android:layout_height=\"wrap_content\"
            android:text=\"Notch\" />

        <EditText
            android:id=\"@+id/filter_notch_hz\"
            android:layout_width=\"match_parent\"
            android:layout_height=\"wrap_content\"
            android:hint=\"Notch Hz\"
            android:inputType=\"numberDecimal\" />

        <Switch
            android:id=\"@+id/filter_band_pass\"
            android:layout_width=\"match_parent\"
            android:layout_height=\"wrap_content\"
            android:text=\"Band pass\" />

        <EditText
            android:id=\"@+id/filter_band_low_hz\"
            android:layout_width=\"match_parent\"
            android:layout_height=\"wrap_content\"
            android:hint=\"Band low Hz\"
            android:inputType=\"numberDecimal\" />

        <EditText
            android:id=\"@+id/filter_band_high_hz\"
            android:layout_width=\"match_parent\"
            android:layout_height=\"wrap_content\"
            android:hint=\"Band high Hz\"
            android:inputType=\"numberDecimal\" />

        <EditText
            android:id=\"@+id/filter_order\"
            android:layout_width=\"match_parent\"
            android:layout_height=\"wrap_content\"
            android:hint=\"Order 1-6\"
            android:inputType=\"number\" />

        <Button
            android:id=\"@+id/button_preview\"
            android:layout_width=\"match_parent\"
            android:layout_height=\"wrap_content\"
            android:text=\"@string/audio_filter_preview\" />

        <Button
            android:id=\"@+id/button_live_preview\"
            android:layout_width=\"match_parent\"
            android:layout_height=\"wrap_content\"
            android:text=\"Start Live Preview\" />

        <ImageView
            android:id=\"@+id/spectrogram_view\"
            android:layout_width=\"match_parent\"
            android:layout_height=\"200dp\"
            android:scaleType=\"fitXY\"
            android:visibility=\"gone\" />

        <TextView
            android:id=\"@+id/filter_status\"
            android:layout_width=\"match_parent\"
            android:layout_height=\"wrap_content\"
            android:minHeight=\"48dp\"
            android:text=\"@string/audio_filter_preview_status\" />

        <Button
            android:id=\"@+id/button_save\"
            android:layout_width=\"match_parent\"
            android:layout_height=\"wrap_content\"
            android:text=\"@string/menu_save\" />

        <Button
            android:id=\"@+id/button_reset\"
            android:layout_width=\"match_parent\"
            android:layout_height=\"wrap_content\"
            android:text=\"@string/reset_filters\" />
    </LinearLayout>
</ScrollView>
